<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>&lt;함께 걸어요&gt; 24인승 미니버스 좌석 예약</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans KR', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f3f6f4;
            -webkit-tap-highlight-color: transparent;
        }
        .seat-btn {
            transition: transform 0.12s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        }
        .seat-btn:active {
            transform: scale(0.96);
        }
        .locked-seat-pattern {
            background-color: #e2e8f0;
            background-image: repeating-linear-gradient(
                -45deg,
                #e2e8f0,
                #e2e8f0 6px,
                #cbd5e1 6px,
                #cbd5e1 12px
            );
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="text-slate-800 antialiased pb-16">

    <!-- 상단 헤더 -->
    <header class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-teal-800 text-white shadow-md sticky top-0 z-30">
        <div class="max-w-3xl mx-auto px-4 py-3.5 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-white/15 border border-white/25 flex items-center justify-center text-xl shrink-0">
                    🥾
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                        <span class="text-[11px] font-black bg-amber-300 text-emerald-950 px-2 py-0.5 rounded-md">정기 트레킹 모임</span>
                        <span id="syncStatusBadge" class="text-[11px] font-bold bg-emerald-950/60 border border-emerald-400/40 text-emerald-100 px-2 py-0.5 rounded-md flex items-center gap-1">
                            <span id="syncStatusDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                            <span id="syncStatusText">실시간 동기화 연결 중...</span>
                        </span>
                    </div>
                    <h1 id="headerClubTitle" class="font-black text-base sm:text-xl tracking-tight truncate mt-0.5">&lt;함께 걸어요&gt; 24인승 미니버스 좌석 예약</h1>
                </div>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" onclick="manualRefreshSync()" title="최신 현황 새로고침" class="bg-white/15 hover:bg-white/25 active:bg-white/30 border border-white/30 text-white text-xs sm:text-sm font-bold px-2.5 py-2.5 rounded-xl flex items-center gap-1 transition">
                    <span>🔄</span>
                    <span class="hidden sm:inline">새로고침</span>
                </button>
                <button type="button" onclick="openAdminModal()" class="bg-white/15 hover:bg-white/25 active:bg-white/30 border border-white/30 text-white text-xs sm:text-sm font-bold px-3.5 py-2.5 rounded-xl flex items-center gap-1.5 transition">
                    <span>⚙️</span>
                    <span>총무 설정</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 메인 컨테이너 -->
    <main class="max-w-3xl mx-auto px-3 sm:px-5 pt-4 space-y-5">

        <!-- 1. 산행 목적지, 출발 일자 및 탑승장소·시각 안내 카드 -->
        <section class="bg-white rounded-3xl shadow-sm border-2 border-emerald-200 p-4 sm:p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3.5 border-b border-slate-100">
                <div>
                    <span class="inline-block text-xs font-extrabold bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-lg mb-1">이번 트레킹 목적지</span>
                    <h2 id="displayDestination" class="text-lg sm:text-xl font-black text-slate-900 leading-snug">
                        🏔️ 무등산 편백자연휴양림 둘레길
                    </h2>
                </div>
                <div class="bg-emerald-50 border border-emerald-200 px-3.5 py-2 rounded-2xl shrink-0 self-start sm:self-center">
                    <p class="text-[11px] font-bold text-emerald-700">📅 출발 일자</p>
                    <p id="displayDepartureDate" class="text-sm sm:text-base font-black text-emerald-950">2026년 11월 넷째 주 토요일</p>
                </div>
            </div>

            <!-- 탑승장소별 출발시각 배지 -->
            <div class="pt-3.5">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-xs sm:text-sm font-extrabold text-slate-700">🚌 탑승장소 및 탑승시각 안내</p>
                    <span class="text-[11px] text-slate-400">출발 5분 전 대기</span>
                </div>
                <div id="headerStopsContainer" class="flex flex-wrap gap-2">
                    <!-- JS 동적 렌더링 -->
                </div>
            </div>
        </section>

        <!-- 2. 승차 가능 정원 및 실시간 예약 현황 -->
        <section id="capacityStatusCard" class="bg-white rounded-3xl shadow-sm border-2 border-slate-200 p-4 sm:p-5 transition">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="text-base sm:text-lg font-black text-slate-900">👥 승차 정원 및 예약 현황</span>
                </div>
                <span id="capacityStatusBadge" class="text-xs font-black bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full">
                    예약 가능
                </span>
            </div>

            <!-- 정원 도달 시 표시되는 마감 안내 배너 -->
            <div id="capacityFullAlert" class="hidden mb-3 bg-red-600 text-white rounded-2xl p-3.5 flex items-center gap-2.5 shadow-xs">
                <span class="text-xl shrink-0">🚫</span>
                <div class="text-xs sm:text-sm leading-snug">
                    <p class="font-black">예약 마감 (승차 가능 정원 도달)</p>
                    <p class="text-red-100 font-medium mt-0.5">지정된 승차 정원이 모두 찼습니다. 기존 예약자의 자리 이동이나 취소만 가능합니다.</p>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-2.5 text-center">
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3">
                    <p class="text-xs font-bold text-slate-500">승차 가능 정원</p>
                    <p class="text-xl sm:text-2xl font-black text-slate-800 mt-0.5"><span id="maxCapacityDisplay">17</span><span class="text-xs font-bold text-slate-500 ml-0.5">명</span></p>
                    <p id="activeSeatsSubText" class="text-[11px] text-slate-400 mt-0.5">개방 좌석 17석</p>
                </div>
                <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-3">
                    <p class="text-xs font-bold text-emerald-700">현재 예약</p>
                    <p class="text-xl sm:text-2xl font-black text-emerald-700 mt-0.5"><span id="reservedCount">0</span><span class="text-xs font-bold ml-0.5">명</span></p>
                    <p id="reservedSubText" class="text-[11px] text-emerald-600 mt-0.5">일반 0 · 보조 0</p>
                </div>
                <div id="remainingBox" class="bg-amber-50 border border-amber-200 rounded-2xl p-3">
                    <p id="remainingLabel" class="text-xs font-bold text-amber-800">잔여 정원</p>
                    <p id="remainingValueWrap" class="text-xl sm:text-2xl font-black text-amber-700 mt-0.5"><span id="availableCount">17</span><span class="text-xs font-bold ml-0.5">명</span></p>
                    <p id="remainingSubText" class="text-[11px] text-amber-700/80 mt-0.5">예약 가능 인원</p>
                </div>
            </div>
        </section>

        <!-- 3. 24인승 미니버스 좌석 배치도 -->
        <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                <div>
                    <h2 class="text-base sm:text-lg font-black text-slate-900">💺 24인승 미니버스 좌석 배치도</h2>
                    <p class="text-xs text-slate-500 mt-0.5">빈 좌석을 터치하면 예약 등록, 예약된 좌석을 터치하면 자리 이동/수정이 가능합니다.</p>
                </div>
                <!-- 범례 -->
                <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-bold">
                    <span class="inline-flex items-center gap-1 bg-white border-2 border-emerald-500 text-emerald-800 px-2 py-0.5 rounded-md">빈 좌석</span>
                    <span class="inline-flex items-center gap-1 bg-emerald-600 text-white px-2 py-0.5 rounded-md">예약완료</span>
                    <span class="inline-flex items-center gap-1 locked-seat-pattern border border-slate-400 text-slate-700 px-2 py-0.5 rounded-md">🔒 미사용(잠금)</span>
                    <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 px-2 py-0.5 rounded-md">조금불편</span>
                </div>
            </div>

            <!-- 자리 이동(변경) 모드 안내 배너 -->
            <div id="moveModeBanner" class="hidden mb-4 bg-amber-400 text-slate-950 rounded-2xl p-3.5 shadow-md flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-xl shrink-0">🔄</span>
                    <div class="min-w-0">
                        <p id="moveModeTitle" class="text-xs sm:text-sm font-black truncate">이동할 빈 좌석을 선택해 주세요</p>
                        <p class="text-[11px] font-bold text-slate-900/80">노란색 테두리의 개방된 빈 좌석을 누르면 자리가 즉시 옮겨집니다.</p>
                    </div>
                </div>
                <button type="button" onclick="cancelMoveMode()" class="shrink-0 bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold px-3 py-2 rounded-xl transition">
                    취소
                </button>
            </div>

            <!-- 버스 외형 프레임 -->
            <div class="max-w-md mx-auto bg-slate-100 border-4 border-slate-300 rounded-[2.2rem] p-3 sm:p-4 shadow-inner">
                <!-- 버스 앞면 표시 -->
                <div class="bg-slate-700 text-white text-center py-2 rounded-t-2xl rounded-b-lg mb-3.5 shadow-xs">
                    <span class="text-xs sm:text-sm font-extrabold tracking-widest">▲ 버스 앞쪽 (진행 방향) ▲</span>
                </div>

                <!-- 좌석 그리드 (1열 ~ 7열) -->
                <div id="busSeatGrid" class="space-y-2.5"></div>

                <!-- 버스 뒷면 표시 -->
                <div class="mt-3.5 pt-2 border-t-2 border-dashed border-slate-300 text-center">
                    <span class="text-[11px] font-bold text-slate-400">버스 뒤쪽 (트렁크 방향)</span>
                </div>
            </div>
        </section>

        <!-- 4. 탑승장소별 인원 집계 (시간순 자동 정리) -->
        <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-5">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <h2 class="text-base sm:text-lg font-black text-slate-900">📍 탑승장소별 인원 집계 (시간순)</h2>
                    <p class="text-xs text-slate-500 mt-0.5">장소를 누르면 해당 정류장 탑승자만 좌석표와 명단에서 강조해 볼 수 있습니다.</p>
                </div>
                <button type="button" id="resetFilterBtn" onclick="setLocationFilter('ALL')" class="hidden text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg transition">
                    전체 보기
                </button>
            </div>
            <div id="stopSummaryContainer" class="space-y-2">
                <!-- JS 동적 렌더링 -->
            </div>
        </section>

        <!-- 5. 자동 생성 탑승자 명단 & 밴드 공지 복사 / HTML 다운로드 -->
        <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-3 border-b border-slate-100">
                <div>
                    <h2 class="text-base sm:text-lg font-black text-slate-900">📋 자동 생성 탑승자 명단</h2>
                    <p class="text-xs text-slate-500 mt-0.5">좌석 예약 및 이동과 동시에 명단이 자동으로 정리됩니다.</p>
                </div>
                <!-- 정렬 버튼 -->
                <div class="flex bg-slate-100 p-1 rounded-xl self-start sm:self-auto">
                    <button type="button" id="sortSeatBtn" onclick="setSortMode('seat')" class="px-3 py-1.5 text-xs font-extrabold rounded-lg bg-white text-emerald-800 shadow-xs transition">좌석순</button>
                    <button type="button" id="sortTimeBtn" onclick="setSortMode('time')" class="px-3 py-1.5 text-xs font-extrabold rounded-lg text-slate-600 hover:text-slate-900 transition">탑승시각순</button>
                    <button type="button" id="sortNameBtn" onclick="setSortMode('name')" class="px-3 py-1.5 text-xs font-extrabold rounded-lg text-slate-600 hover:text-slate-900 transition">가나다순</button>
                </div>
            </div>

            <!-- 명단 테이블 -->
            <div class="overflow-x-auto mt-3">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-600 text-xs sm:text-sm border-b border-slate-200">
                            <th class="py-2.5 px-2 font-extrabold text-center w-20">좌석번호</th>
                            <th class="py-2.5 px-2.5 font-extrabold">성함</th>
                            <th class="py-2.5 px-2.5 font-extrabold">탑승장소</th>
                            <th class="py-2.5 px-2 font-extrabold text-center w-20">탑승시각</th>
                            <th class="py-2.5 px-2 font-extrabold text-center w-16">변경</th>
                        </tr>
                    </thead>
                    <tbody id="rosterTableBody" class="divide-y divide-slate-100 text-sm sm:text-base">
                        <!-- JS 동적 렌더링 -->
                    </tbody>
                </table>
            </div>

            <!-- 밴드 공지용 텍스트 복사 및 파일 저장 버튼 -->
            <div class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <button type="button" onclick="copyBandAnnouncement()" class="w-full bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 text-white font-extrabold py-4 px-4 rounded-2xl shadow-sm flex items-center justify-center gap-2 text-sm sm:text-base transition">
                    <span>📋</span>
                    <span>밴드 공지용 텍스트 복사</span>
                </button>
                <button type="button" onclick="downloadStandaloneHtml()" class="w-full bg-slate-800 hover:bg-slate-900 active:bg-slate-950 text-white font-extrabold py-4 px-4 rounded-2xl shadow-sm flex items-center justify-center gap-2 text-sm sm:text-base transition">
                    <span>💾</span>
                    <span>함께걸어요.html 파일 저장</span>
                </button>
            </div>
        </section>

    </main>

    <!-- [모달 1] 빈 좌석 예약 등록 모달 -->
    <div id="reserveModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden">
            <div class="bg-emerald-800 text-white px-5 py-4 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span id="modalSeatBadge" class="bg-amber-300 text-emerald-950 font-black text-sm px-2.5 py-1 rounded-lg">2번 좌석</span>
                    <h3 class="font-extrabold text-lg">좌석 예약하기</h3>
                </div>
                <button type="button" onclick="closeModal('reserveModal')" class="text-white/80 hover:text-white text-2xl leading-none px-1">&times;</button>
            </div>

            <form onsubmit="submitReservation(event)" class="p-5 space-y-4 max-h-[84vh] overflow-y-auto">
                <input type="hidden" id="reserveSeatKey">
                <input type="hidden" id="selectedStopTime">

                <!-- 조금불편 좌석 또는 보조석 안내 배너 -->
                <div id="uncomfortableWarning" class="hidden bg-amber-50 border-2 border-amber-300 rounded-2xl p-3 flex items-start gap-2.5">
                    <span class="text-lg leading-none mt-0.5">⚠️</span>
                    <p id="uncomfortableWarningText" class="text-xs sm:text-sm font-bold text-amber-900 leading-snug">
                        앞자리/뒷바퀴 부근이라 다른 좌석보다 조금 불편할 수 있습니다.
                    </p>
                </div>

                <!-- 1. 성함 입력 -->
                <div>
                    <label for="inputMemberName" class="block text-sm font-extrabold text-slate-800 mb-1.5">
                        1. 회원 성함 <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="inputMemberName" maxlength="12" required placeholder="예: 홍길동 (동반 시 홍길동2)" class="w-full text-base sm:text-lg px-4 py-3 rounded-2xl border-2 border-slate-300 focus:border-emerald-600 focus:outline-none font-bold">
                </div>

                <!-- 2. 탑승장소 및 시각 선택 -->
                <div>
                    <label class="block text-sm font-extrabold text-slate-800 mb-1.5">
                        2. 탑승장소 및 탑승시각 선택 <span class="text-red-500">*</span>
                    </label>
                    <div id="stopButtonsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <!-- JS로 정류장 버튼 렌더링 -->
                    </div>

                    <!-- 기타 직접 입력 칸 -->
                    <div id="customStopContainer" class="hidden mt-2.5 bg-emerald-50/70 border border-emerald-200 rounded-2xl p-3 space-y-2.5">
                        <div>
                            <label for="inputCustomStopName" class="block text-xs font-extrabold text-emerald-900 mb-1">탑승장소 직접 입력 *</label>
                            <input type="text" id="inputCustomStopName" maxlength="20" placeholder="예: 일로읍사무소 앞" class="w-full text-sm sm:text-base px-3.5 py-2.5 rounded-xl border-2 border-emerald-500 bg-white font-bold focus:outline-none">
                        </div>
                        <div>
                            <label for="inputCustomStopTime" class="block text-xs font-extrabold text-emerald-900 mb-1">탑승시각 (선택)</label>
                            <input type="text" id="inputCustomStopTime" maxlength="10" placeholder="예: 08:10" class="w-full text-sm sm:text-base px-3.5 py-2.5 rounded-xl border border-emerald-400 bg-white font-bold focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- 하단 버튼 -->
                <div class="pt-2 flex gap-2.5">
                    <button type="button" onclick="closeModal('reserveModal')" class="w-1/3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-extrabold py-3.5 rounded-2xl text-sm sm:text-base transition">
                        취소
                    </button>
                    <button type="submit" class="w-2/3 bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold py-3.5 rounded-2xl text-sm sm:text-base shadow-sm transition">
                        좌석 예약 완료
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- [모달 2] 예약된 좌석 확인 · 수정 · 자리 이동 · 취소 모달 -->
    <div id="detailModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden">
            <div class="bg-slate-800 text-white px-5 py-4 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span id="detailSeatBadge" class="bg-emerald-400 text-slate-950 font-black text-sm px-2.5 py-1 rounded-lg">2번 좌석</span>
                    <h3 class="font-extrabold text-lg">예약 확인 및 자리 변경</h3>
                </div>
                <button type="button" onclick="closeModal('detailModal')" class="text-white/80 hover:text-white text-2xl leading-none px-1">&times;</button>
            </div>

            <div class="p-5 space-y-4 max-h-[84vh] overflow-y-auto">
